---
interface Props {
  locale: 'en' | 'zh-cn';
}

const { locale } = Astro.props;
const isChinese = locale === 'zh-cn';
const prefix = isChinese ? '/zh-cn' : '';
const email = 'ronktsang+gpk@gmail.com';
const copy = isChinese ? {
  intro: '遇到问题或有改进建议？欢迎联系。选择你方便的方式，我们可以继续沟通。',
  emailTitle: '邮箱支持',
  emailDescription: '直接给我发邮件，我会通过邮件回复。无需注册新的账号，也适合发送截图、录屏或不便公开的细节。',
  send: '发送邮件', copy: '复制邮箱', copied: '邮箱已复制', failed: '复制失败，请手动选择上方邮箱地址。',
  template: '我想使用的功能：\n\n我是怎么操作的：\n\n实际发生了什么：\n\n我原本期待什么：\n\n截图或录屏（可选；如能提供会很有帮助）：\n\n浏览器及版本（可选，不清楚可留空）：\n插件版本（可选，不清楚可留空）：\nGemini 界面语言（可选）：',
  communityTitle: '社区与公开反馈',
  githubDescription: '报告 Bug、提出建议，或查看已有问题的进展。提交问题需要 GitHub 账号，内容公开可见。',
  githubAction: '前往 GitHub Issues',
  xTitle: 'X',
  xDescription: '直接联系 @RonkTsang，并关注 Gemini Power Kit 的项目动态。',
  xAction: '前往 X',
  detailsTitle: '哪些信息有助于排查？',
  details: ['你当时想做什么，以及做了哪些操作。', '实际发生了什么，以及你原本期待什么。', '截图或短录屏不是必需；如果能提供，会很有助于判断问题。发送前请隐藏聊天内容、邮箱等私人信息。'],
  templateTitle: '复制反馈模板（可选）',
  copyTemplate: '复制反馈模板',
  templateCopied: '反馈模板已复制',
  helpTitle: '也可以先看看',
  faq: '常见问题', troubleshooting: '通知问题排查', updates: '最新动态',
} : {
  intro: 'Having trouble or have an idea? Get in touch through whichever channel works for you, and we can continue the conversation.',
  emailTitle: 'Email support',
  emailDescription: 'Email me directly and I’ll reply by email. No new account needed. This is also a good place for screenshots, recordings, or details you prefer to keep private.',
  send: 'Send an email', copy: 'Copy email', copied: 'Email copied', failed: 'Could not copy. Please select and copy the email address above.',
  template: 'Feature I was trying to use:\n\nWhat I did:\n\nWhat happened:\n\nWhat I expected:\n\nScreenshot or recording (optional, but very helpful if available):\n\nBrowser and version (optional — leave blank if unsure):\nExtension version (optional — leave blank if unsure):\nGemini interface language (optional):',
  communityTitle: 'Community & public feedback',
  githubDescription: 'Report a bug, suggest an improvement, or follow existing issues. Posting requires a GitHub account, and your report will be public.',
  githubAction: 'Visit GitHub Issues',
  xTitle: 'X',
  xDescription: 'Contact @RonkTsang directly and follow Gemini Power Kit updates.',
  xAction: 'Open X',
  detailsTitle: 'What helps with troubleshooting?',
  details: ['What you were trying to do and the steps you took.', 'What happened and what you expected instead.', 'A screenshot or short recording is optional, but very helpful if you can share one. Please hide chat content, email addresses, and other private information before sharing.'],
  templateTitle: 'Copy a feedback template (optional)',
  copyTemplate: 'Copy feedback template',
  templateCopied: 'Feedback template copied',
  helpTitle: 'You might find an answer here',
  faq: 'FAQ', troubleshooting: 'Notification troubleshooting', updates: 'What’s new',
};
const mailto = `mailto:${email}?subject=${encodeURIComponent('[Gemini Power Kit] Support')}&body=${encodeURIComponent(copy.template)}`;
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  name: isChinese ? '获取帮助 — Gemini Power Kit' : 'Support — Gemini Power Kit',
  description: copy.intro,
  url: `https://gpk.ronktsang.com${prefix}/support/`,
  inLanguage: isChinese ? 'zh-CN' : 'en',
  isPartOf: { '@type': 'WebSite', name: 'Gemini Power Kit', url: 'https://gpk.ronktsang.com/' },
};
---

<script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
<div class="support-content">
  <p class="intro">{copy.intro}</p>

  <section class="email-card" aria-labelledby="email-support">
    <h2 id="email-support"><svg class="section-icon" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2" /><path d="m3 7 9 6 9-6" /></svg>{copy.emailTitle}</h2>
    <p>{copy.emailDescription}</p>
    <a class="email-address" href={mailto}>{email}</a>
    <div class="actions">
      <a class="primary-action" href={mailto}>{copy.send}<span aria-hidden="true">↗</span></a>
      <button type="button" data-copy-email={email} data-success={copy.copied} data-failure={copy.failed} hidden>{copy.copy}</button>
    </div>
    <p class="copy-status" role="status" aria-live="polite"></p>
  </section>

  <section aria-labelledby="community">
    <h2 id="community">{copy.communityTitle}</h2>
    <div class="community-cards not-content">
      <div class="community-card">
        <h3><svg class="section-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2C6.48 2 2 6.58 2 12.23c0 4.52 2.87 8.35 6.84 9.7.5.1.68-.22.68-.49 0-.24-.01-1.04-.01-1.89-2.78.62-3.37-1.2-3.37-1.2-.45-1.18-1.11-1.49-1.11-1.49-.91-.64.07-.63.07-.63 1 .07 1.53 1.06 1.53 1.06.9 1.57 2.35 1.12 2.92.86.09-.67.35-1.12.64-1.38-2.22-.26-4.56-1.15-4.56-5.11 0-1.13.39-2.05 1.04-2.78-.1-.26-.45-1.31.1-2.74 0 0 .85-.28 2.75 1.06A9.3 9.3 0 0 1 12 6.3c.85 0 1.71.12 2.51.35 1.91-1.34 2.75-1.06 2.75-1.06.55 1.43.2 2.48.1 2.74.65.73 1.04 1.65 1.04 2.78 0 3.97-2.35 4.84-4.58 5.1.36.32.68.93.68 1.88 0 1.36-.01 2.45-.01 2.78 0 .27.18.6.69.49A10.22 10.22 0 0 0 22 12.23C22 6.58 17.52 2 12 2Z" /></svg>GitHub</h3>
        <p>{copy.githubDescription}</p>
        <a href="https://github.com/RonkTsang/gemini-chat-extension/issues">{copy.githubAction} <span aria-hidden="true">↗</span></a>
      </div>
      <div class="community-card">
        <h3><svg class="section-icon x-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M18.9 2H22l-6.78 7.75L23.2 22h-6.25l-4.9-7.12L5.8 22H2.7l7.25-8.29L2.3 2h6.4l4.43 6.5L18.9 2Zm-1.09 18h1.72L7.76 3.9H5.91L17.81 20Z" /></svg>{copy.xTitle}</h3>
        <p>{copy.xDescription}</p>
        <a href="https://x.com/RonkTsang">{copy.xAction} <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </section>

  <section aria-labelledby="report-details">
    <h2 id="report-details">{copy.detailsTitle}</h2>
    <ul>{copy.details.map(detail => <li>{detail}</li>)}</ul>
    <div class="feedback-template">
      <h3>{copy.templateTitle}</h3>
      <pre><code>{copy.template}</code></pre>
      <button type="button" data-copy-text={copy.template} data-success={copy.templateCopied} data-failure={copy.failed}>{copy.copyTemplate}</button>
      <p class="copy-status" role="status" aria-live="polite"></p>
    </div>
  </section>

  <section aria-labelledby="self-help">
    <h2 id="self-help">{copy.helpTitle}</h2>
    <ul class="help-links">
      <li><a href={`${prefix}/support/faq/`}>{copy.faq}</a></li>
      <li><a href={`${prefix}/support/notification-troubleshooting/`}>{copy.troubleshooting}</a></li>
      <li><a href={`${prefix}/support/whats-new/`}>{copy.updates}</a></li>
    </ul>
  </section>

</div>

<script>
  function setupSupportCopy(): void {
    document.querySelectorAll<HTMLButtonElement>('[data-copy-email], [data-copy-text]').forEach(button => {
      if (button.dataset.initialized) return;
      button.dataset.initialized = 'true';
      button.hidden = false;
      button.addEventListener('click', async () => {
        const status = button.closest('section')?.querySelector<HTMLElement>('.copy-status');
        if (!status) return;
        try {
          await navigator.clipboard.writeText(button.dataset.copyText ?? button.dataset.copyEmail ?? '');
          status.textContent = button.dataset.success ?? '';
        } catch {
          status.textContent = button.dataset.failure ?? '';
        }
      });
    });
  }
  setupSupportCopy();
  document.addEventListener('astro:page-load', setupSupportCopy);
</script>

<style>
  .support-content { max-width: 48rem; }
  .support-content .intro { font-size: 1.15rem; color: var(--sl-color-gray-2); }
  .support-content section { margin-top: 2.5rem; }
  .support-content h2 { font-size: 1.45rem; margin-top: 0; }
  .support-content h3 { font-size: 1.1rem; margin-top: 0; }
  .email-card h2, .community-card h3 { display: flex; align-items: center; gap: 0.45em; }
  .section-icon { width: 1.1em; height: 1.1em; flex: 0 0 auto; fill: currentColor; stroke: currentColor; stroke-linecap: round; stroke-linejoin: round; }
  .email-card .section-icon { fill: none; stroke-width: 1.8; }
  .email-card { padding: clamp(1.25rem, 4vw, 2rem); border: 1px solid var(--sl-color-accent); border-radius: 1rem; background: var(--sl-color-accent-low); }
  .email-address { display: inline-block; margin-top: 1rem; font-size: clamp(1rem, 3vw, 1.35rem); font-weight: 600; overflow-wrap: anywhere; }
  .actions { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 1.25rem; }
  .actions > * { margin-top: 0; display: inline-flex; align-items: center; justify-content: center; gap: 0.75rem; min-height: 2.75rem; padding: 0.6rem 1rem; border-radius: 0.5rem; font: inherit; font-weight: 600; cursor: pointer; text-decoration: none; }
  .actions .primary-action { background: var(--sl-color-text-accent); color: var(--sl-color-bg); border: 1px solid transparent; }
  .actions button { background: transparent; color: var(--sl-color-text); border: 1px solid currentColor; }
  .actions button[hidden] { display: none; }
  .actions > *:hover { text-decoration: underline; text-underline-offset: 0.2em; }
  .support-content :is(a, button):focus-visible { outline: 2px solid var(--sl-color-text-accent); outline-offset: 4px; }
  .copy-status { font-size: var(--sl-text-sm); }
  .copy-status:empty { display: none; }
  .feedback-template { margin-top: 1.5rem; padding: 1.25rem; border: 1px solid var(--sl-color-hairline-shade); border-radius: 0.75rem; }
  .feedback-template h3 { margin-bottom: 0.25rem; }
  .feedback-template p { margin-top: 0; }
  .feedback-template pre { margin: 1rem 0; padding: 1rem; border: 1px solid var(--sl-color-hairline-shade); border-radius: 0.5rem; background: var(--sl-color-bg); white-space: pre-wrap; overflow-wrap: anywhere; }
  .feedback-template button { min-height: 2.5rem; padding: 0.5rem 0.875rem; border: 1px solid currentColor; border-radius: 0.5rem; background: transparent; color: var(--sl-color-text); font: inherit; font-weight: 600; cursor: pointer; }
  .community-cards { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); align-items: stretch; gap: 1rem; }
  .community-cards > .community-card { display: flex; min-height: 100%; margin-top: 0; box-sizing: border-box; flex-direction: column; padding: 1.25rem; border: 1px solid var(--sl-color-hairline-shade); border-radius: 0.75rem; }
  .community-card > a { margin-top: auto; }
  .help-links { display: flex; flex-wrap: wrap; gap: 0.75rem 1.5rem; padding: 0; list-style: none; }
  .help-links li { margin: 0; }
  @media (max-width: 36rem) { .community-cards { grid-template-columns: 1fr; } }
</style>
